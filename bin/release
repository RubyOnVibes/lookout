#!/usr/bin/env bash

VERSION=$1
now=$(date +'%b %d, %Y')
sed -i '' -e "s/## Unreleased/## Version $VERSION ($now)/" CHANGELOG.md
sed -i '' -e "s/# Changelog/# Changelog \n\n## Unreleased\n\nNothing, yet./" CHANGELOG.md
bundle
git add Gemfile.lock CHANGELOG.md
git commit -m "Bump version for $VERSION"
git push
git tag -m "v$VERSION release" $VERSION
git push rubygem --follow-tags
gem build lookout.gemspec
gem push "lookout-ahoy-$VERSION.gem" --host https://rubygems.org
rm "lookout-ahoy-$VERSION.gem"
